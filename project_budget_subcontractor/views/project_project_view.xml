<odoo>
    <record id="edit_project" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <field name="use_budget" invisible="1" />
                <group
                    string="Current Budget"
                    invisible="not current_budget_id and not use_budget"
                    colspan="2"
                >
                    <group>
                        <field name="current_budget_id" invisible="1" />
                        <field name="currency_id" invisible="1" />
                        <field
                            name="current_budget_amount"
                            widget="monetary"
                            options="{'currency_field': 'currency_id'}"
                        />
                        <field
                            name="current_invoiced_amount"
                            widget="monetary"
                            options="{'currency_field': 'currency_id'}"
                        />
                        <field
                            name="current_to_invoice_amount"
                            widget="monetary"
                            options="{'currency_field': 'currency_id'}"
                        />
                        <field
                            name="current_remaining_amount"
                            widget="monetary"
                            options="{'currency_field': 'currency_id'}"
                        />
                    </group>
                    <group>
                        <field
                            name="current_remaining_budget"
                            widget="monetary"
                            options="{'currency_field': 'currency_id'}"
                        />
                        <field
                            name="current_budget_amount_prorata"
                            widget="monetary"
                            options="{'currency_field': 'currency_id'}"
                        />
                        <field
                            name="current_budget_progress"
                            widget="percentage"
                            decoration-danger="current_budget_progress >= 100"
                            decoration-warning="current_budget_progress > current_time_progress and current_budget_progress &lt; 100"
                        />
                        <field name="current_time_progress" widget="percentage" />
                    </group>
                </group>
            </xpath>

            <page name="description" position="after">
                <field name="use_budget" invisible="1" />
                <page name="budget_page" string="Budgets" invisible="not use_budget">
                    <field name="budget_ids">
                        <list
                            editable="bottom"
                            decoration-info="id and id == parent.current_budget_id"
                        >
                            <field name="id" invisible="1" />
                            <field name="currency_id" invisible="1" />
                            <field name="name" />
                            <field name="start_date" />
                            <field name="end_date" />
                            <field
                                name="budget_amount"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                            />
                            <field
                                name="invoiced_amount"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                            />
                            <field
                                name="to_invoice_amount"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                            />
                            <field
                                name="remaining_amount"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                            />
                            <field
                                name="remaining_budget"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                            />
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>

    <record id="view_project_kanban" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allow_milestones']" position="after">
                <field name="use_budget" />
                <field name="current_budget_progress" />
                <field name="current_time_progress" />
            </xpath>

            <xpath expr="//div[hasclass('o_project_kanban_boxes')]" position="inside">
                <a
                    t-if="record.use_budget.raw_value and record.current_budget_progress.raw_value > 0"
                    class="o_project_kanban_box o_project_timesheet_box"
                    type="open"
                    groups="project.group_project_user"
                >
                    <div>
                        <t
                        t-out="(record.current_budget_progress.raw_value * 100).toFixed(2)"
                    />% /
                        <t
                        t-out="(record.current_time_progress.raw_value * 100).toFixed(2)"
                    />%
                    </div>
                </a>
            </xpath>
        </field>
    </record>
</odoo>
