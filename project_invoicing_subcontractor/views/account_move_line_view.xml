<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_invoice_line_form" model="ir.ui.view">
        <field name="model">account.move.line</field>
        <field name="type">form</field>
        <field
            name="inherit_id"
            ref="account_invoice_subcontractor.view_move_line_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="before">
                <field name="task_id" readonly="1" invisible="not task_id" />
                <field
                    name="task_invoiceable_days"
                    readonly="1"
                    invisible="not task_id"
                />
            </xpath>
            <field name="quantity" position="after">
                <field name="timesheet_error" invisible="not timesheet_error" />
            </field>
            <xpath expr="//group[@name='subcontractor']" position="after">
                <group
                    name="timesheet_information"
                    string="Timesheet"
                    invisible="not timesheet_line_ids"
                >
                    <field name="timesheet_line_ids" nolabel="1">
                        <list>
                            <field name="date" />
                            <field name="user_id" />
                            <field name="name" />
                            <field name="unit_amount" sum="Total" widget="float_time" />
                            <field name="discount" />
                            <field
                                name="invoiceable_amount"
                                sum="Total"
                                widget="float_time"
                            />
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_line_filter" model="ir.ui.view">
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_account_move_line_filter" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='pl_accounts']" position="after">
                <separator />
                <filter
                    string="Prepaid is paid"
                    name="prepaid_is_paid"
                    domain="[['prepaid_is_paid', '=',True]]"
                />
            </xpath>
        </field>
    </record>
</odoo>
