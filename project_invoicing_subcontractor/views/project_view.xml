<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="project_project_view_form" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <field name="project_health_state" invisible="1" />
                <button
                    class="oe_stat_button"
                    name="action_project_prepaid_move_line"
                    type="object"
                    icon="fa-usd"
                    invisible="invoicing_mode != 'customer_prepaid'"
                    help="The amount available on this project IF the customer pay all its invoice. It does not take into account the timesheet not invoiced yet."
                >
                    <div class="o_field_widget o_stat_info">
                        <div class="oe_inline">
                            <span
                                class="text-success"
                                invisible="project_health_state != 'high'"
                            >
                                <field name="prepaid_total_amount" nolabel="1" />
                            </span>
                            <span
                                class="text-warning"
                                invisible="project_health_state != 'medium'"
                            >
                                <field name="prepaid_total_amount" nolabel="1" />
                            </span>
                            <span
                                class="text-danger"
                                invisible="project_health_state != 'low'"
                            >
                                <field name="prepaid_total_amount" nolabel="1" />
                            </span>
                        </div>
                        <span class="o_stat_text">Available if paid</span>
                    </div>
                </button>
                <button
                    class="oe_stat_button"
                    name="action_project_prepaid_move_line"
                    type="object"
                    icon="fa-usd"
                    invisible="invoicing_mode != 'customer_prepaid'"
                    context="{'prepaid_is_paid': True}"
                    help="The amount currently available on this project. If you invoice timesheet for a lesser amount, the invoices will be paid soon."
                >
                    <div class="o_field_widget o_stat_info">
                        <div class="oe_inline">
                            <span
                                class="text-success"
                                invisible="project_health_state != 'high'"
                            >
                                <field name="prepaid_available_amount" nolabel="1" />
                            </span>
                            <span
                                class="text-warning"
                                invisible="project_health_state != 'medium'"
                            >
                                <field name="prepaid_available_amount" nolabel="1" />
                            </span>
                            <span
                                class="text-danger"
                                invisible="project_health_state != 'low'"
                            >
                                <field name="prepaid_available_amount" nolabel="1" />
                            </span>
                        </div>
                        <span class="o_stat_text">Available Immediately</span>
                    </div>
                </button>
                <button
                    class="oe_stat_button"
                    name="action_project_timesheet_lines"
                    type="object"
                    icon="fa-calendar"
                    help="The amount of the timesheet not invoiced yet."
                >
                    <div class="o_stat_info">
                        <div class="oe_inline">
                            <span
                                class="text-success"
                                invisible="project_health_state != 'high'"
                            >
                                <field
                                    name="not_invoiced_timesheet_amount"
                                    nolabel="1"
                                />
                            </span>
                            <span
                                class="text-warning"
                                invisible="project_health_state != 'medium'"
                            >
                                <field
                                    name="not_invoiced_timesheet_amount"
                                    nolabel="1"
                                />
                            </span>
                            <span
                                class="text-danger"
                                invisible="project_health_state != 'low'"
                            >
                                <field
                                    name="not_invoiced_timesheet_amount"
                                    nolabel="1"
                                />
                            </span>
                        </div>
                        <span class="o_stat_text">To Invoice</span>
                    </div>
                </button>
            </div>
            <field name="partner_id" position="attributes">
                <attribute name="required">invoicing_typology_id</attribute>
            </field>
            <group name="extra_settings" position="after">
                <group string="Invoicing" name="invoicing">
                    <field name="invoicing_typology_id" />
                    <field name="invoicing_mode" />
                    <field
                        name="uom_id"
                        string="Default Invoice uom"
                        invisible="force_uom_id or not uom_id"
                    />
                    <field
                        name="force_uom_id"
                        string="Force Invoice uom"
                        invisible="not invoicing_typology_id or invoicing_mode not in ['customer_postpaid', 'supplier']"
                        required="not uom_id"
                    />
                    <field name="price_unit" />
                    <field
                        name="supplier_invoice_price_unit"
                        invisible="invoicing_mode not in ('customer_prepaid', 'supplier')"
                        required="invoicing_mode == 'supplier'"
                    />
                </group>
            </group>
            <field name="force_uom_id" position="after">
                <field name="hour_uom_id" position="move" />
            </field>
            <field name="hour_uom_id" position="attributes">
                <attribute name="invisible">not is_hour_uom_visible</attribute>
            </field>
        </field>
    </record>
</odoo>
