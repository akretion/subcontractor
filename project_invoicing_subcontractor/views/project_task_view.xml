<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="project_task_view_form" model="ir.ui.view">
        <field name="model">project.task</field>
        <field name="inherit_id" ref="hr_timesheet.view_task_form2_inherited" />
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='unit_amount']" position="after">
                <field name="discount" />
            </xpath>
            <field name="remaining_hours" position="after">
                <field
                    name="invoiceable_hours"
                    widget="float_time"
                    class="oe_subtotal_footer_separator"
                />
            </field>
        </field>
    </record>
    <record id="view_task_kanban" model="ir.ui.view">
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban" />
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="invoiceable_hours" />
                <field name="remaining_hours" />
                <field name="allocated_hours" />
            </xpath>
            <xpath expr="//field[@name='name']" position="replace">
                <div class="d-flex align-items-start justify-content-between w-100">
                    <field name="name" class="fw-bold fs-5" />
                    <div class="ms-2 flex-shrink-0">
                        <t t-set="inv_color" t-value="'text-success border-success'" />
                        <t
                            t-if="record.remaining_hours.raw_value &lt; 0 and record.allocated_hours.raw_value &gt; 0"
                            t-set="inv_color"
                            t-value="'text-danger border-danger'"
                        />
                        <div
                            t-attf-class="badge border {{ inv_color }} p-1 px-2"
                            style="font-size: 0.7rem; font-weight: bold; background: transparent;"
                            title="Invoiceable Hours"
                        >
                            <field name="invoiceable_hours" widget="timesheet_uom" />
                        </div>
                    </div>
                </div>
            </xpath>
            <xpath expr="//main//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
