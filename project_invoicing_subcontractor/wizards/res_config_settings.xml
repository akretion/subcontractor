<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_ecotaxe_res_config_settings_inherit" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="account_invoice_subcontractor.view_ecotaxe_res_config_settings"
        />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='subcontractor-settings']" position="inside">
                <div class="content-group">
                    <div class="row mt16">
                        <label
                            for="prepaid_countdown_journal_id"
                            class="col-lg-3 o_light_label"
                        />
                        <field
                            name="prepaid_countdown_journal_id"
                            options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                        />
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
