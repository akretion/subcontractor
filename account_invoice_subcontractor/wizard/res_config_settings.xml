<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_ecotaxe_res_config_settings" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='analytic']" position="after">
                <block title="Subcontractors" id="subcontractor">
                    <setting
                        id="subcontractor-settings"
                        help="Configure the default commission rate for subcontractors"
                    >
                        <div class="content-group">
                            <div class="row mt16">
                                <label
                                    for="commission_rate"
                                    class="col-lg-3 o_light_label"
                                />
                                <field name="commission_rate" />
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
