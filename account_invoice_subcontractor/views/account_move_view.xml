<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_subcontractor_invoices"
                    type="object"
                    string="Subcontractor Invoices"
                    class="oe_stat_button"
                    icon="fa-pencil-square-o"
                    invisible="not subcontractor_invoice_ids"
                />
                <button
                    name="action_view_customer_invoices"
                    type="object"
                    string="Customer Invoices"
                    class="oe_stat_button"
                    icon="fa-pencil-square-o"
                    invisible="not customer_invoice_ids"
                />
            </div>
            <field name="partner_id" position="after">
                <field name="customer_invoice_ids" invisible="1" />
                <field name="subcontractor_invoice_ids" invisible="1" />
            </field>
            <xpath expr="//list/field[@name='name']" position="after">
                <field name="subcontracted" optional="hide" />
                <field
                    name="subcontractors"
                    column_invisible="parent.move_type not in ('out_invoice', 'out_refund')"
                />
            </xpath>
            <xpath expr="//list/field[@name='price_subtotal']" position="after">
                <field name="invalid_work_amount" column_invisible="1" />
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list" position="attributes">
                <attribute
                    name="decoration-danger"
                >invalid_work_amount == True</attribute>
            </xpath>
            <xpath
                expr="/form/sheet/notebook/page[1][@id='invoice_tab']/field[1]/form/sheet/group[2]/field[2]"
                position="attributes"
            >
                <attribute name="readonly">0</attribute>
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']/form//field[@name='price_subtotal']"
                position="before"
            >
                <field name="subcontracted" invisible="1" />
                <field
                    name="subcontractor_work_invoiced_id"
                    invisible="not subcontracted and not subcontractor_work_invoiced_id"
                />
            </xpath>
            <!-- Use default view button now
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[last()]"
                position="after"
            >
                <button
                    name="edit_subcontractor"
                    type="object"
                    string="Edit Sub."
                    invisible="parent.move_type not in ['out_invoice', 'out_refund'] or not subcontracted"
                />
            </xpath>
            -->
        </field>
    </record>

    <!-- VIEW FOR THE OBJECT : account.move -->
    <record id="view_invoice_tree" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="before">
                <field name="to_pay" />
                <field name="invalid_work_amount" />
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <filter name="open" position="after">
                <filter
                    name="to_pay"
                    string="To pay"
                    domain="[('to_pay','=',True)]"
                    help="Invoices to be pay"
                />
            </filter>
        </field>
    </record>
</odoo>
